title = {{An Algebraic Framework for Minimum Spanning Tree Problems}},
journal = {Theoretical Computer Science},
volume = {744},
pages = {37-55},
year = {2018},
note = {Theoretical aspects of computing},
issn = {0304-3975},
doi = {https://doi.org/10.1016/j.tcs.2018.04.012},
url = {https://www.sciencedirect.com/science/article/pii/S0304397518302342},
author = {Walter Guttmann},
keywords = {Aggregation, Correctness proof, Formal methods, Kleene algebras, Relations, Stone algebras, Weighted graphs},
abstract = {We formally prove that Prim's minimum spanning tree algorithm is correct for various optimisation problems with different aggregation functions. The original minimum weight spanning tree problem and the minimum bottleneck spanning tree problem are special cases, but the framework covers many other problems. To this end we work in new generalisations of relation algebras and Kleene algebras and in new algebraic structures that capture key operations used in Prim's algorithm and its specification. Weighted graphs form instances of these algebraic structures, where edge weights are taken from a linear order with a binary aggregation operation. Many existing results from relation algebras and Kleene algebras generalise from the relation model to the weighted-graph model with no or small changes. The overall structure of the proof uses Hoare logic. All results are formally verified in Isabelle/HOL heavily using its integrated automated theorem provers. This paper is an extended version of [36].}
}

