@article{irvfail,
	abstract = {It has long been recognized that Instant Runoff Voting (IRV) suffers from a defect known as nonmonotonicity, wherein increasing support for a candidate among a subset of voters may adversely affect that candidate's election outcome. The expected frequency of this type of behavior, however, remains an open and important question, and limited access to detailed election data makes it difficult to resolve empirically. In this paper, we develop a spatial model of voting behavior to approach the question theoretically. We conclude that monotonicity failures in three-candidate IRV elections may be much more prevalent than widely presumed (results suggest a lower bound estimate of 15 {\%} for competitive elections). In light of these results, those seeking to implement a fairer multi-candidate election system should be wary of adopting IRV.},
	author = {Ornstein, Joseph T. and Norman, Robert Z.},
	date = {2014/10/01},
	date-added = {2024-09-04 12:55:15 +0100},
	date-modified = {2024-09-04 12:55:15 +0100},
	doi = {10.1007/s11127-013-0118-2},
	id = {Ornstein2014},
	isbn = {1573-7101},
	journal = {Public Choice},
	number = {1},
	pages = {1--9},
	title = {{Frequency of monotonicity failure under Instant Runoff Voting: estimates based on a spatial model of elections}},
	url = {https://doi.org/10.1007/s11127-013-0118-2},
	volume = {161},
	year = {2014},
	bdsk-url-1 = {https://doi.org/10.1007/s11127-013-0118-2}}

@article{84f4877f-78d8-36b9-b3ef-98f3b505fdc4,
 ISSN = {00925853, 15405907},
 URL = {http://www.jstor.org/stable/2110496},
 abstract = {Single Transferrable Vote, a type of proportional representation voting system, is presently used in a number of countries throughout the world, and expansion of its use is strongly supported by the Electoral Reform Society of Great Britain and Ireland. In this paper we show that the Single Transferrable Vote will not always count votes positively. It is possible, for example, that a candidate could win an election if 10,000 people voted for him or her, but would lose that election if he or she received an additional 5,000 votes. We will also show that similar results may occur using the Two Stage Majority System. Finally, we examine the implications of our finding with respect to the desirability of using the Single Transferrable Vote as an election rule.},
