 journal = {American Journal of Political Science},
 number = {2},
 pages = {303--311},
 publisher = {[Midwest Political Science Association, Wiley]},
 title = {{Single Transferrable Vote: An Example of a Perverse Social Choice Function}},
 urldate = {2024-09-04},
 volume = {21},
 year = {1977}
}

